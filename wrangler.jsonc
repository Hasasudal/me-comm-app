{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micom",
  "account_id": "c6585635ced99c193cb7a7fdadb6b927",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micom-lounge",
      "database_id": "eee8564e-e13a-4394-b0f7-af5d9688e62d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "micom-images" }]
}
