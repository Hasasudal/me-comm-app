{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micom",
  "account_id": "c6585635ced99c193cb7a7fdadb6b927",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Scheduled newsletters (worker/index.ts); a send starts up to 10 minutes after its time.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Old versions must not stay reachable at <version>-micom.*.workers.dev with production bindings.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micom-lounge",
      "database_id": "eee8564e-e13a-4394-b0f7-af5d9688e62d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "micom-images" }]
}
